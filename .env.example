# Copy to ralph/.env (gitignored) and fill in. ralph auto-loads it.
#
# Token the SANDBOXED implementer authenticates with — get one via `claude setup-token`.
# The host stages (reviewer/PR/verify) use your logged-in ~/.claude and don't need this.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an API key instead:
# ANTHROPIC_API_KEY=
